	filename images/out-CrossValidation-ModelsTraits-RANDOM50.pdf
	lyxscale 50
	scale 40

\end_inset


\end_layout

\begin_layout Plain Layout
\begin_inset Caption Standard

\begin_layout Plain Layout
Comparison of prediction methods using 50 random markers.
\end_layout

